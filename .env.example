# No API key is required. Copy to .env for your own notes; the server reads environment variables.
# PowerShell: $env:PORT='3000'; npm start
PORT=3000
HOST=127.0.0.1
# Explicit Docker bridge opt-in only; keep the published port bound to 127.0.0.1.
# ALLOW_REMOTE=1
# DATA_DIR=../handout
# RUNTIME_DIR=./runtime
# Optional real local embedding model, installed with npm run models:setup
# MODEL_DIR=./runtime/models/multilingual-e5-small
# INDEX_DIR=./runtime/indexes
# Fast HTTP/batch drafts use validated code context by default; no LLM is run.
# Native HTTP/batch drafts are a separate slower, explicitly configured mode.
# TRIAGE_DRAFT_MODE=fast
# TRIAGE_DRAFT_MODE=native
# Native requires LOCAL_GENERATOR=1, model focus and an operator activation manifest.
# Experimental generation remains available as an explicit UI action in fast mode.
# Install separately with npm run generator:setup. Defaults to off.
# LOCAL_GENERATOR=1
# Optional explicit override; otherwise the installed Q4 is preferred, then Q8.
# Produce the local Q4 separately with npm run generator:quantize after setup.
# GENERATOR_MODEL_PATH=./runtime/models/qwen3-0.6b/Qwen3-0.6B-Q4_K_M.gguf
# GENERATOR_RUNTIME_PATH=./runtime/tools/llama-b11960-cpu/llama-server.exe
# GENERATOR_TIMEOUT_MS=60000
# Native triage reserves up to 4400ms for bounded context preparation within this budget.
# Two-phase topic + plan mode requires a verified model family, memory and quality.
# Private validation receipts are rejected by the ordinary server startup.
# GENERATOR_FOCUS_MODE=model
# GENERATOR_ACTIVATION_MANIFEST=./runtime/models/verified-candidate/operator-activation.json
