{
  "name": "grand-mobile-support-copilot",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "description": "Local semantic support intelligence with grounded drafts, quality evaluation and operator workflows",
  "engines": {
    "node": ">=22"
  },
  "files": [
    "npm-shrinkwrap.json",
    "src/",
    "public/",
    "data/knowledge.json",
    "data/intents.json",
    "data/hosting-demo/rules.json",
    "data/hosting-demo/taxonomy.json",
    "data/focus-demonstrations-v7.json",
    "data/routing-training-v8-alpha.json",
    "data/routing-training-v8-beta.json",
    "data/routing-training-v9-role.json",
    "fixtures/demo-tickets.json",
    "fixtures/control.json",
    "fixtures/retrieval-holdout-v2.json",
    "fixtures/training-author-synthetic.jsonl",
    "fixtures/training-plan-author-synthetic.jsonl",
    "fixtures/generation-plan-holdout.json",
    "fixtures/generation-plan-control-v3.json",
    "fixtures/generation-plan-control-v4.json",
    "fixtures/generation-plan-control-v5.json",
    "fixtures/generation-plan-control-v6.json",
    "fixtures/generation-plan-control-v7.json",
    "fixtures/generation-plan-control-v8.json",
    "fixtures/generation-plan-control-v9.json",
    "fixtures/generation-plan-control-v10.json",
    "fixtures/generation-plan-control-v11.json",
    "fixtures/generation-plan-control-v12.json",
    "scripts/",
    "tests/",
    "docs/",
    "training/",
    "notebooks/",
    "README.md",
    "Makefile",
    "Dockerfile",
    "render.yaml",
    ".dockerignore",
    ".env.example",
    "start-support.cmd",
    "start-local-ai.cmd"
  ],
  "scripts": {
    "start": "node src/server.mjs",
    "dev": "node --watch src/server.mjs",
    "test": "node --test --test-concurrency=1 tests/*.test.mjs",
    "predict": "node src/cli/predict.mjs",
    "evaluate": "node scripts/evaluate.mjs",
    "package:check": "node scripts/package-check.mjs",
    "models:setup": "node scripts/setup-models.mjs",
    "models:benchmark": "node scripts/benchmark-models.mjs",
    "generator:setup": "node scripts/setup-generator.mjs",
    "generator:quantize": "node scripts/quantize-generator.mjs",
    "generator:benchmark": "node scripts/benchmark-generator.mjs",
    "training:prepare": "node scripts/prepare-training.mjs",
    "import": "node scripts/import-tickets.mjs",
    "evaluate:v2": "node scripts/evaluate-v2.mjs"
  },
  "dependencies": {
    "@huggingface/transformers": "3.8.1"
  }
}
